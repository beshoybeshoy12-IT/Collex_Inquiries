# Where the app finds the Collex Inquiries API (the /api/v1 prefix included).
# Copy to `.env` and set it. A phone cannot reach "localhost" on your
# computer: use the computer's LAN address while developing, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5100/api/v1
# and the real HTTPS address for a production build.
EXPO_PUBLIC_API_URL=http://localhost:5100/api/v1
