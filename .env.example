# ═══════════════════════════════════════════════════════════════════════════
#  Collex Inquiries — environment template
# ═══════════════════════════════════════════════════════════════════════════
#  Copy to `.env` (root, for docker compose) and `server/.env` (for local runs).
#  Never commit a filled-in copy: this file is the only one that belongs in git.
#
#  Variables marked REQUIRED are read through `requireEnv()` and throw at
#  module load. A container that will not start is a better failure than one
#  that starts and drops photos on the floor.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
# REQUIRED
POSTGRES_USER=collex
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=collex_inquiries
# This is the HOST view, used by `npm run start:local`, `prisma migrate dev`
# and Prisma Studio. Inside `docker compose` the api container rebuilds it
# against the service name (postgres:5432) from POSTGRES_* above, because
# "localhost" there means the api container itself. Override that with
# DATABASE_URL_DOCKER to point the stack at a managed database.
DATABASE_URL=postgresql://collex:change-me-in-production@localhost:5434/collex_inquiries?schema=public

# Pool size PER REPLICA. Keep (DB_CONNECTION_LIMIT x replicas) comfortably under
# Postgres's max_connections (default 100). A connection_limit already spelled
# out in DATABASE_URL wins over this.
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=10

# ─── API ────────────────────────────────────────────────────────────────────
PORT=5100
# Comma-separated. Defaults to the Vite dev origin when unset.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CLIENT_URL=http://localhost:5174
# Number of proxy hops to trust for client IPs. 0 when nothing is in front.
TRUST_PROXY=0

# ─── Authentication ─────────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Separate secret for refresh tokens, so a leaked access-token secret cannot
# mint refresh tokens. Falls back to JWT_SECRET with a warning if unset.
JWT_REFRESH_SECRET=

# Access tokens are short because they cannot be revoked individually without a
# denylist lookup. Refresh tokens carry the session lifetime.
# An unparseable value throws at boot rather than falling back — a silently
# wrong token lifetime is a security bug.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Mobile investigators are re-authenticated far less conveniently than a desk
# user, so their sessions live longer.
JWT_INVESTIGATOR_REFRESH_EXPIRES_IN=90d

# Account lockout after repeated failures.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# ─── Redis (cache, rate limiting, BullMQ) ───────────────────────────────────
# Without this the API still runs: the queue falls back to INLINE execution and
# logs a loud warning at boot. Inline mode is for local development only — it
# runs PDF generation and imports inside the request that triggered them.
# Host view again; compose uses redis://redis:6379 (override: REDIS_URL_DOCKER).
REDIS_URL=redis://localhost:6381

# ─── Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ───────────
# STORAGE_DRIVER=s3 requires the four S3_* values below.
# STORAGE_DRIVER=local writes under server/storage/ and is for development only;
# it cannot issue real presigned URLs, so uploads go through the API instead.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=collex-inquiries
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing is required by MinIO and optional on R2.
S3_FORCE_PATH_STYLE=true
# How long a presigned upload or download URL stays valid, in seconds.
S3_PRESIGN_TTL=900
# Hard ceiling enforced before a presigned upload URL is issued, in megabytes.
UPLOAD_MAX_MB=25

# ─── Mail ───────────────────────────────────────────────────────────────────
# Optional. Without a host the mailer logs what it would have sent instead of
# sending, so development never silently mails real people.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Collex Inquiries <no-reply@collex.local>"

# ─── Scheduled work ─────────────────────────────────────────────────────────
# How often the SLA/escalation sweep runs, and how long a stale assignment
# offer waits before it is swept. Escalation thresholds themselves are rows in
# `escalation_rules`, not env values.
SLA_SWEEP_CRON=*/5 * * * *
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=730
EXPORT_RETENTION_DAYS=7

# ─── Seed (development only) ────────────────────────────────────────────────
# The seeder refuses to run without these; there is no fallback password.
SEED_TENANT_CODE=DEMO
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Platform operator ──────────────────────────────────────────────────────
# The one account that can create customer companies. `isSuperAdmin` is
# deliberately unreachable from the API, so it is granted by running
#   npm run db:platform-admin --prefix server
# which reads these. Required in EVERY environment, including production —
# unlike the seed block above, this is not development-only.
#
# There is no fallback password. Generate one:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# and unset it again once you have signed in.
PLATFORM_TENANT_CODE=PLATFORM
PLATFORM_ADMIN_EMAIL=operator@collex.local
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=
# Set to true to rotate the password of an operator that already exists.
PLATFORM_ADMIN_RESET=false
