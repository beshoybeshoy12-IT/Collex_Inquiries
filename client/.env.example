# Client build-time settings. Copy to client/.env.local — never commit real values.

# Unset in development: requests go through the Vite proxy to the API.
VITE_API_URL=

# Google Maps JavaScript API — a BROWSER key. It is visible in the page by
# design; protect it in Google Cloud with HTTP-referrer and API restrictions
# (Maps JavaScript API only). Unset = the live map shows a key-less view.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (needed for advanced markers). Defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
